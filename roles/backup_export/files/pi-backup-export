#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: pi-backup-export [check]" >&2
  exit 2
}

[[ $# -le 1 ]] || usage
[[ $# -eq 0 || "$1" == "check" ]] || usage

remote_user="${SUDO_USER:-}"
if [[ ! "$remote_user" =~ ^[a-z_][a-z0-9_-]*$ || "$remote_user" == "root" ]]; then
  echo "A non-root sudo caller is required" >&2
  exit 1
fi

home_dir="$(getent passwd "$remote_user" | cut -d: -f6)"
[[ -n "$home_dir" && -d "$home_dir" ]] || {
  echo "Caller home is unavailable" >&2
  exit 1
}

paths=("$home_dir")
for path in /etc /usr/lib/os-release /usr/local /opt /srv /boot/firmware /boot; do
  [[ -e "$path" ]] && paths+=("$path")
done

if [[ "${1:-}" == "check" ]]; then
  command -v tar >/dev/null
  printf 'backup-export-ready user=%s paths=%d\n' "$remote_user" "${#paths[@]}"
  exit 0
fi

export LC_ALL=C
exec tar --one-file-system --ignore-failed-read --warning=no-file-changed \
  --exclude=.cache --exclude='*/.cache' --exclude='*/__pycache__' --exclude='*.pyc' \
  -cpf - "${paths[@]}"

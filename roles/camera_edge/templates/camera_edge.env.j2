# Generated by mri-cooling-pi-fleet

CAMERA_BACKEND_URL={{ camera_edge.camera_backend_url }}
SITE_ID={{ camera_edge.site_id }}

CAPTURE_INTERVAL={{ camera_edge.capture_interval | default(60) }}
IMAGE_WIDTH={{ camera_edge.image_width | default(1920) }}
IMAGE_HEIGHT={{ camera_edge.image_height | default(1080) }}

UPLOAD_ENABLED={{ (camera_edge.upload_enabled | default(true)) | ternary('true','false') }}
UPLOAD_MODE={{ camera_edge.upload_mode | default('full_and_crop') }}

OCR_CROP_COORDS={{ {
  "x": (camera_edge.ocr_crop_coords.x | default(708)),
  "y": (camera_edge.ocr_crop_coords.y | default(520)),
  "w": (camera_edge.ocr_crop_coords.w | default(364)),
  "h": (camera_edge.ocr_crop_coords.h | default(182))
} | to_json }}

DEBUG_SAVE_IMAGES={{ (camera_edge.debug_save_images | default(true)) | ternary('true','false') }}

CALIBRATION_MODE={{ (camera_edge.calibration_mode | default(false)) | ternary('true','false') }}
CALIBRATION_URL={{ camera_edge.calibration_url }}

{% if camera_edge.shutter_speed is defined and (camera_edge.shutter_speed | string | length) > 0 -%}
SHUTTER_SPEED={{ camera_edge.shutter_speed }}
{% endif -%}
{% if camera_edge.gain is defined and (camera_edge.gain | string | length) > 0 -%}
GAIN={{ camera_edge.gain }}
{% endif -%}
{% if camera_edge.captures_per_session is defined and (camera_edge.captures_per_session | string | length) > 0 -%}
CAPTURES_PER_SESSION={{ camera_edge.captures_per_session }}
{% endif -%}

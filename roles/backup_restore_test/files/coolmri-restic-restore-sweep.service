[Unit]
Description=Verify every configured CoolMRI Pi Restic repository
Wants=network-online.target
After=network-online.target restic-pi-pull-backup.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/coolmri-restic-restore-sweep
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=3G
MemoryMax=4G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/t7backup/restic-pi-repos /var/cache/coolmri-restic /var/lib/coolmri-fleet/restore-tests /run

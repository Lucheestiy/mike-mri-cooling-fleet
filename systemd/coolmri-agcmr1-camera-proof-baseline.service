[Unit]
Description=Capture AGC MR1 v3 pre-schedule camera proof baseline
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/mlweb/mri-cooling-pi-fleet
ExecStart=/home/mlweb/mri-cooling-pi-fleet/scripts/start_camera_observation.sh agcmr1 AGCMR1 10 2026-07-18T09:00:00-04:00 camera_edge_v3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mlweb/mri-cooling-pi-fleet/reports
TimeoutStartSec=180
